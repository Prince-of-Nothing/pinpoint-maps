{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Prince-of-Nothing/pinpoint-maps/main/catalog.schema.json",
  "title": "Pinpoint map catalog",
  "description": "Schema 1 of the region catalog published by pinpoint-maps. Region ids and per-region file roles are unique; scripts/validate-catalog.mjs enforces those two rules.",
  "type": "object",
  "required": ["schema", "updated", "regions"],
  "properties": {
    "schema": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "minLength": 1
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/region"
      }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "required": ["id", "name", "bbox", "maxzoom", "version", "files"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        },
        "maxzoom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 22
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "role",
        "transfer_name",
        "installed_name",
        "url",
        "transfer_bytes",
        "transfer_sha256",
        "installed_bytes",
        "installed_sha256",
        "compression"
      ],
      "properties": {
        "role": {
          "enum": ["basemap", "graph"]
        },
        "transfer_name": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[^/\\\\:]+$"
        },
        "installed_name": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[^/\\\\:]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s/]+\\S*$"
        },
        "transfer_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "transfer_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "installed_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "installed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compression": {
          "enum": ["identity", "gzip"]
        }
      }
    }
  }
}
